---
import '../styles/global.css';
import { ui, type Language } from '../i18n/translations';
import { getHreflangLinks, SITE_URL } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  currentLang?: Language;
  image?: string;
}

const {
  title = "YonkoStash — The Ultimate Ad-Free Gaming Arsenal",
  description = "High-performance, ad-free, direct-speed gaming portal curated for pirates and shinobi alike. Zero popups, 100% verified repacks.",
  currentLang = (Astro.params.lang as Language) || 'en',
  image = "/favicon-96x96.png"
} = Astro.props;

const pathname = Astro.url.pathname;
const cleanPath = pathname === '/' ? '' : pathname.replace(/\/$/, '');
const canonicalUrl = `${SITE_URL}${cleanPath === '' ? '/' : cleanPath}`;
const hreflangLinks = getHreflangLinks(pathname);
const htmlLang = currentLang === 'hinglish' ? 'hi-Latn' : currentLang;
const ogImageUrl = image.startsWith('http://') || image.startsWith('https://') ? image : `${SITE_URL}${image}`;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="YonkoStash" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & SEO Hreflang Tags (Multilingual SEO Strategy) -->
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((item) => (
      <link rel="alternate" hreflang={item.hreflang} href={item.href} />
    ))}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0F" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="YonkoStash" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <!-- Pass i18n translations dictionary to client -->
    <script is:inline define:vars={{ translations: ui, pageLang: currentLang }}>
      window.__I18N_TRANSLATIONS__ = translations;
      window.__CURRENT_PAGE_LANG__ = pageLang;
    </script>

    <!-- Theme & i18n Global Initialization Script -->
    <script is:inline>
      // 1. Theme Initialization
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);

      // Global theme toggle function
      window.toggleTheme = function() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        window.dispatchEvent(new CustomEvent('theme-toggle', { detail: { isDark } }));
      };

      // 2. Keyboard shortcut: 'D' or 'd' to toggle dark mode
      document.addEventListener('keydown', (e) => {
        const target = e.target;
        const isInput = target && (
          target.tagName === 'INPUT' || 
          target.tagName === 'TEXTAREA' || 
          target.isContentEditable
        );
        if (isInput || e.ctrlKey || e.metaKey || e.altKey) return;

        if (e.key === 'd' || e.key === 'D') {
          e.preventDefault();
          window.toggleTheme();
        }
      });

      // 3. i18n Translation Engine & SEO URL Switcher
      window.getTranslation = function(key, fallback) {
        fallback = fallback || '';
        const currentLang = localStorage.getItem('yonko_lang') || window.__CURRENT_PAGE_LANG__ || 'en';
        const dict = window.__I18N_TRANSLATIONS__?.[currentLang] || window.__I18N_TRANSLATIONS__?.['en'];
        return dict?.[key] || window.__I18N_TRANSLATIONS__?.['en']?.[key] || fallback;
      };

      window.setLanguage = function(lang, navigate) {
        if (!window.__I18N_TRANSLATIONS__?.[lang]) lang = 'en';
        localStorage.setItem('yonko_lang', lang);
        document.documentElement.setAttribute('lang', lang === 'hinglish' ? 'hi-en' : lang);

        // Update elements with data-i18n
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const translation = window.getTranslation(key, el.textContent || '');
          if (translation) {
            el.textContent = translation;
          }
        });

        // Update elements with data-i18n-placeholder
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (!key) return;
          const translation = window.getTranslation(key, el.getAttribute('placeholder') || '');
          if (translation) {
            el.setAttribute('placeholder', translation);
          }
        });

        // Update current-lang badges
        document.querySelectorAll('.current-lang-text').forEach((el) => {
          el.textContent = lang.toUpperCase();
        });

        // Update active classes on language buttons
        document.querySelectorAll('.lang-option').forEach((btn) => {
          const btnLang = btn.getAttribute('data-lang');
          if (btnLang === lang) {
            btn.classList.add('text-[#FF5722]', 'bg-mist', 'font-bold');
            btn.classList.remove('text-muted');
          } else {
            btn.classList.remove('text-[#FF5722]', 'bg-mist', 'font-bold');
            btn.classList.add('text-muted');
          }
        });

        window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));

        // SEO URL Navigation when user explicitly selects a language
        if (navigate) {
          const supportedLocales = ['hi', 'hinglish', 'gu', 'es', 'fr', 'zh', 'ja'];
          const segments = window.location.pathname.split('/').filter(Boolean);
          if (segments.length > 0 && supportedLocales.includes(segments[0])) {
            segments.shift();
          }
          const baseCleanPath = '/' + segments.join('/');
          const targetUrl = lang === 'en' 
            ? (baseCleanPath === '' ? '/' : baseCleanPath)
            : (baseCleanPath === '/' || baseCleanPath === '' ? `/${lang}` : `/${lang}${baseCleanPath}`);

          if (window.location.pathname !== targetUrl) {
            window.location.href = targetUrl;
          }
        }
      };

      // Auto run translation on load without triggering redirect
      document.addEventListener('DOMContentLoaded', () => {
        // Detect language from URL prefix first
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const supportedLocales = ['hi', 'hinglish', 'gu', 'es', 'fr', 'zh', 'ja'];
        let activeLang = 'en';
        if (pathSegments.length > 0 && supportedLocales.includes(pathSegments[0])) {
          activeLang = pathSegments[0];
        } else if (window.__CURRENT_PAGE_LANG__) {
          activeLang = window.__CURRENT_PAGE_LANG__;
        } else {
          activeLang = localStorage.getItem('yonko_lang') || 'en';
        }
        window.setLanguage(activeLang, false);
      });
    </script>

    <!-- Google Fonts Preconnect & Inter / JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="antialiased selection:bg-[#22D3EE]/30 selection:text-white font-sans min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Ambient Background Lighting & Mesh Gradients -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-grid-pattern opacity-70">
      <!-- Chakra Cyan ambient glow (top left) -->
      <div class="absolute -top-[20%] -left-[10%] w-[600px] h-[600px] rounded-full bg-[#FF5722]/10 blur-[130px]"></div>
      <!-- Kyuubi Orange / Conqueror Red ambient glow (top right) -->
      <div class="absolute -top-[15%] -right-[10%] w-[650px] h-[650px] rounded-full bg-[#22D3EE]/10 blur-[140px]"></div>
      <!-- Deep Haki Red glow (center lower) -->
      <div class="absolute top-[45%] left-1/2 -translate-x-1/2 w-[800px] h-[450px] rounded-full bg-[#FF3333]/5 blur-[160px]"></div>
    </div>

    <!-- Content Slot -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
