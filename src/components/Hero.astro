---
// Hero.astro - Powerful Hero Section with Kyuubi to Conqueror's Haki Text Gradient
---

<section id="hero-section" class="relative pt-12 pb-14 md:pt-20 md:pb-20 overflow-hidden perspective-[1200px]">
  <!-- Hero 3D Interactive Glow Accents -->
  <div id="hero-glow" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl h-80 bg-gradient-to-tr from-[#22D3EE]/15 via-transparent to-[#FF5722]/15 blur-[100px] pointer-events-none rounded-full transition-transform duration-700 ease-out"></div>

  <div id="hero-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 transition-transform duration-200 ease-out">
    
    <!-- Anime Pill Announcement Tag -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-mist border border-main text-xs font-mono text-main mb-6 shadow-sm hover:border-[#FF5722]/40 transition-colors">
      <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-[#22D3EE]/20 text-[#22D3EE] text-[10px] font-bold">
        🔥
      </span>
      <span class="text-muted" data-i18n="hero.version_live">Version 2.0 Live:</span>
      <span class="text-white font-medium" data-i18n="hero.repacks">Over 2,400+ Repacked Games</span>
      <span class="text-[#FF5722] font-semibold">→</span>
    </div>

    <!-- Main Headline with Chakra Flow Gradient -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-mono font-extrabold tracking-tight text-white mb-6 max-w-4xl mx-auto leading-[1.1]">
      <span data-i18n="hero.title1">Unlock the</span> <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#22D3EE] to-[#FF5722] animate-gradient" data-i18n="hero.title2">
        Ultimate Arsenal.
      </span>
    </h1>

    <!-- Sub-headline -->
    <p class="text-base sm:text-lg md:text-xl text-muted max-w-2xl mx-auto mb-8 sm:mb-10 leading-relaxed font-sans" data-i18n="hero.subtitle">
      Ad-free, blazing-fast game library. Built for pirates and shinobi who demand pure unthrottled downloads without fake buttons or intrusive trackers.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-12 sm:mb-16">
      <a 
        href="#bounties" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl font-mono font-bold text-sm text-white bg-[#FF5722] hover:bg-[#F4511E] shadow-xl shadow-orange-500/20 hover:shadow-orange-400/40 hover:border-[#FF5722] border border-transparent transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#FF5722]"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span data-i18n="hero.cta1">Explore The Bounties</span>
      </a>

      <a 
        href="#features" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-mono font-semibold text-sm text-main bg-mist hover:bg-[#1A1A2A] border border-main hover:border-hover transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#FF5722]"
      >
        <svg class="w-4 h-4 text-[#FF5722]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span data-i18n="hero.cta2">Why We Outrank Steamunlocked</span>
      </a>
    </div>

    <!-- Micro Value Pillars / Trust Badges (Vercel Precision Style) -->
    <div id="features" class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-4 max-w-5xl mx-auto pt-6 border-t border-main">
      
      <div class="flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-lg bg-mist/60 border border-white/[0.04] text-left">
        <div class="p-2 rounded-md bg-[#22D3EE]/10 text-[#22D3EE] shrink-0 font-mono text-xs font-bold">
          0x
        </div>
        <div>
          <div class="text-xs font-semibold text-white font-mono" data-i18n="feature.ad_title">Zero Ad Popups</div>
          <div class="text-[10px] sm:text-[11px] text-muted leading-tight" data-i18n="feature.ad_desc">No redirect loops or trackers</div>
        </div>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-lg bg-mist/60 border border-white/[0.04] text-left">
        <div class="p-2 rounded-md bg-[#FF5722]/10 text-[#FF5722] shrink-0 font-mono text-xs font-bold">
          ⚡
        </div>
        <div>
          <div class="text-xs font-semibold text-white font-mono" data-i18n="feature.speed_title">Gigabit Mirrors</div>
          <div class="text-[10px] sm:text-[11px] text-muted leading-tight" data-i18n="feature.speed_desc">Direct unthrottled CDN pipes</div>
        </div>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-lg bg-mist/60 border border-white/[0.04] text-left">
        <div class="p-2 rounded-md bg-[#EF4444]/10 text-[#EF4444] shrink-0 font-mono text-xs font-bold">
          🛡️
        </div>
        <div>
          <div class="text-xs font-semibold text-white font-mono" data-i18n="feature.safe_title">SHA-256 Verified</div>
          <div class="text-[10px] sm:text-[11px] text-muted leading-tight" data-i18n="feature.safe_desc">Clean, tested & virus-scanned</div>
        </div>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-lg bg-mist/60 border border-white/[0.04] text-left">
        <div class="p-2 rounded-md bg-emerald-500/10 text-emerald-400 shrink-0 font-mono text-xs font-bold">
          ⚔️
        </div>
        <div>
          <div class="text-xs font-semibold text-white font-mono" data-i18n="feature.dlc_title">Pre-Installed DLCs</div>
          <div class="text-[10px] sm:text-[11px] text-muted leading-tight" data-i18n="feature.dlc_desc">1-click unzip and play</div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // 3D Parallax Tilt for Hero Section
  function initHeroParallax() {
    const heroSection = document.getElementById('hero-section');
    const heroContent = document.getElementById('hero-content');
    const heroGlow = document.getElementById('hero-glow');

    if (!heroSection || !heroContent) return;

    function handleMouseMove(e: MouseEvent) {
      if (window.innerWidth < 768) return; // Only active on tablet/desktop for top performance
      const rect = heroSection.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      const tiltX = (y / (rect.height / 2)) * -4;
      const tiltY = (x / (rect.width / 2)) * 4;

      heroContent.style.transform = `rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) translateZ(10px)`;
      if (heroGlow) {
        heroGlow.style.transform = `translate(calc(-50% + ${(-x * 0.05).toFixed(1)}px), calc(-50% + ${(-y * 0.05).toFixed(1)}px)) scale(1.05)`;
      }
    }

    function handleMouseLeave() {
      heroContent.style.transform = 'rotateX(0deg) rotateY(0deg) translateZ(0px)';
      if (heroGlow) {
        heroGlow.style.transform = 'translate(-50%, -50%) scale(1)';
      }
    }

    heroSection.addEventListener('mousemove', handleMouseMove);
    heroSection.addEventListener('mouseleave', handleMouseLeave);
  }

  document.addEventListener('DOMContentLoaded', initHeroParallax);
</script>

