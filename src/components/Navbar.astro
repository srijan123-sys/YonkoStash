---
// Navbar.astro - Sticky Glassmorphism Header with Anime Theme Accents
import { games } from '../data/games';

const searchData = games.map(game => ({
  id: game.id,
  title: game.title,
  slug: game.slug,
  banner: game.banner,
  genres: game.genres,
  accentColor: game.accentColor
}));
---

<header class="sticky top-0 z-50 w-full border-b border-main bg-void/80 backdrop-blur-md transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2 group shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FF5722] rounded-lg">
      <div class="relative w-8 h-8 rounded bg-gradient-to-br from-[#22D3EE] to-[#FF5722] p-[1px] group-hover:glow-orange transition-all">
        <div class="w-full h-full bg-void rounded flex items-center justify-center">
          <span class="font-mono font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#22D3EE] to-[#FF5722]">Y</span>
        </div>
      </div>
      <span class="font-mono font-bold text-lg tracking-tight hidden sm:block group-hover:text-[#FF5722] transition-colors">
        Yonko<span class="text-[#22D3EE]">Stash</span>
      </span>
    </a>

    <!-- Stats Pill (Hidden on mobile) -->
    <a href="#" class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-mist border border-main hover:border-[#FF5722] transition-all glow-orange group">
      <span class="text-xs font-medium text-muted group-hover:text-[#F4F4F5] transition-colors flex items-center gap-1.5">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#FF5722] animate-pulse"></span>
        Direct Repacks
      </span>
    </a>

    <!-- Central Search Bar (Command-K Style) -->
    <div class="flex-1 max-w-md mx-4 hidden md:block relative">
      <div class="relative group z-50">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted group-focus-within:text-[#FF5722] transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="global-search-input"
          type="text"
          placeholder="Search 2,400+ repacks, shinobi jutsu & games..."
          class="w-full pl-10 pr-16 py-2 bg-mist border border-main hover:border-hover focus:border-[#FF5722] rounded-lg text-sm text-main placeholder:text-muted/60 focus:outline-none focus:ring-1 focus:ring-[#FF5722] transition-all"
        />
        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none">
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono text-muted bg-void border border-main rounded shadow-sm">
            ⌘K
          </kbd>
        </div>
      </div>

      <!-- Search Results Dropdown -->
      <div id="search-dropdown" class="absolute top-full left-0 right-0 mt-2 bg-void/95 backdrop-blur-xl border border-main rounded-xl shadow-2xl opacity-0 invisible transition-all duration-200 transform translate-y-1 z-40 overflow-hidden max-h-[60vh] flex flex-col">
        <div class="px-4 py-2 text-xs font-mono font-bold text-muted uppercase tracking-widest border-b border-main bg-mist/50">
          Search Results
        </div>
        <div id="search-results-list" class="overflow-y-auto p-2 flex flex-col gap-1">
          <!-- Results injected via JS -->
        </div>
        <div id="search-empty-state" class="hidden p-6 text-center text-sm text-muted">
          No jutsu or repacks found.
        </div>
      </div>
      <!-- Overlay to close dropdown -->
      <div id="search-overlay" class="fixed inset-0 bg-black/20 z-30 hidden"></div>
    </div>

    <!-- Navigation Links & Actions -->
    <nav class="flex items-center gap-1 sm:gap-6">
      <div class="hidden lg:flex items-center gap-1 text-sm font-medium">
        <a 
          href="#bounties" 
          data-navbar-filter="all"
          data-i18n="nav.all_games"
          class="navbar-filter-link px-3 py-1.5 rounded-md text-main hover:text-[#22D3EE] hover:bg-mist transition-colors"
        >
          All Games
        </a>
        <a 
          href="#shinobi-wars" 
          data-navbar-filter="shinobi"
          class="navbar-filter-link px-3 py-1.5 rounded-md text-muted hover:text-[#22D3EE] hover:bg-mist transition-colors flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722]"></span>
          <span data-i18n="nav.shinobi_wars">Shinobi Wars</span>
        </a>
        <a 
          href="#grand-fleet" 
          data-navbar-filter="fleet"
          class="navbar-filter-link px-3 py-1.5 rounded-md text-muted hover:text-[#22D3EE] hover:bg-mist transition-colors flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722]"></span>
          <span data-i18n="nav.grand_fleet">Grand Fleet</span>
        </a>
        <a 
          href="#highest-bounties" 
          data-navbar-filter="hot"
          class="navbar-filter-link px-3 py-1.5 rounded-md text-muted hover:text-[#FF5722] hover:bg-mist transition-colors flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722]"></span>
          <span data-i18n="nav.top_bounties">Top Bounties</span>
        </a>
      </div>

      <!-- Quick Action / Status Badge -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Language Switcher (Desktop & Mobile) -->
        <div class="relative" id="lang-switcher-container">
          <button 
            id="lang-toggle" 
            type="button"
            class="px-2.5 py-1.5 flex items-center gap-1.5 rounded-lg border border-main hover:border-[#FF5722] bg-mist/60 hover:bg-mist transition-all text-muted hover:text-main focus:outline-none focus:ring-1 focus:ring-[#FF5722] cursor-pointer" 
            aria-label="Select Language"
            aria-expanded="false"
          >
            <svg class="w-4 h-4 text-[#22D3EE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span class="current-lang-text text-xs font-mono font-bold text-white uppercase tracking-wider">EN</span>
            <svg class="w-3 h-3 text-muted transition-transform duration-200" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div 
            id="lang-menu"
            class="hidden absolute right-0 top-full mt-2 w-48 bg-void/95 backdrop-blur-2xl border border-main rounded-xl shadow-2xl z-50 overflow-hidden py-1.5 divide-y divide-white/[0.06]"
          >
            <div class="px-3 py-1.5 text-[10px] font-mono text-muted uppercase tracking-wider">Select Language</div>
            <div class="p-1 space-y-0.5 max-h-64 overflow-y-auto">
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="en">
                <span>English</span>
                <span class="text-[10px] font-mono text-muted">EN</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="hi">
                <span>हिंदी (Hindi)</span>
                <span class="text-[10px] font-mono text-muted">HI</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="hinglish">
                <span>Hinglish (Desi)</span>
                <span class="text-[10px] font-mono text-[#FF5722] font-bold">HOT</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="es">
                <span>Español</span>
                <span class="text-[10px] font-mono text-muted">ES</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="fr">
                <span>Français</span>
                <span class="text-[10px] font-mono text-muted">FR</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="gu">
                <span>ગુજરાતી (Gujarati)</span>
                <span class="text-[10px] font-mono text-muted">GU</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="zh">
                <span>中文 (Chinese)</span>
                <span class="text-[10px] font-mono text-muted">ZH</span>
              </button>
              <button type="button" class="lang-option w-full px-3 py-1.5 text-xs text-left rounded-md hover:bg-mist hover:text-[#FF5722] transition-colors flex items-center justify-between cursor-pointer" data-lang="ja">
                <span>日本語 (Japanese)</span>
                <span class="text-[10px] font-mono text-muted">JA</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Theme Toggle with D shortcut -->
        <button 
          id="theme-toggle" 
          type="button"
          class="p-2 rounded-lg hover:bg-mist transition-colors text-muted hover:text-main focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FF5722] flex items-center gap-1 cursor-pointer group" 
          aria-label="Toggle Theme"
          title="Press 'D' key on keyboard to toggle theme"
        >
          <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 text-[#22D3EE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <kbd class="hidden sm:inline-block px-1 py-0.5 text-[9px] font-mono text-muted bg-void border border-main rounded group-hover:border-[#FF5722] group-hover:text-[#FF5722] transition-colors">
            D
          </kbd>
        </button>

        <div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono bg-mist border border-main text-muted">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span data-i18n="nav.zero_ads">Zero Ads</span>
        </div>

        <a 
          href="#bounties" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-semibold text-white bg-[#FF5722] hover:bg-[#F4511E] transition-colors shadow-md shadow-orange-500/10 focus:outline-none focus:ring-2 focus:ring-[#FF5722]"
        >
          <span class="hidden sm:inline" data-i18n="nav.vault_access">Vault Access</span>
          <span class="sm:hidden" data-i18n="nav.vault_access">Vault</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="lg:hidden p-1.5 text-muted hover:text-main focus:outline-none rounded-md hover:bg-mist transition-colors" aria-label="Toggle Menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </nav>
  </div>
  
  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full bg-void/98 backdrop-blur-2xl border-b border-main flex-col p-4 gap-3 shadow-2xl lg:hidden z-40 transition-all duration-300 origin-top max-h-[85vh] overflow-y-auto">
    <!-- Quick Search on mobile -->
    <div class="relative md:hidden mb-1">
      <input
        id="mobile-search-input"
        type="text"
        data-i18n-placeholder="nav.search_placeholder"
        placeholder="Search 2,400+ repacks & games..."
        class="w-full pl-9 pr-4 py-2 bg-mist border border-main rounded-lg text-xs text-main placeholder:text-muted/60 focus:outline-none focus:ring-1 focus:ring-[#FF5722]"
      />
      <svg class="w-4 h-4 text-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Navigation links -->
    <a href="#bounties" class="mobile-link px-4 py-2.5 rounded-lg text-main font-medium hover:bg-mist transition-colors border border-transparent hover:border-main flex items-center justify-between">
      <span data-i18n="nav.all_games">All Games</span>
      <span class="text-xs text-muted">→</span>
    </a>
    <a href="#shinobi-wars" class="mobile-link px-4 py-2.5 rounded-lg text-muted hover:text-[#FF5722] hover:bg-mist transition-colors flex items-center gap-3 border border-transparent hover:border-main">
      <span class="w-2 h-2 rounded-full bg-[#22D3EE] shadow-[0_0_8px_#22D3EE]"></span> 
      <span data-i18n="nav.shinobi_wars">Shinobi Wars</span>
    </a>
    <a href="#grand-fleet" class="mobile-link px-4 py-2.5 rounded-lg text-muted hover:text-[#FF5722] hover:bg-mist transition-colors flex items-center gap-3 border border-transparent hover:border-main">
      <span class="w-2 h-2 rounded-full bg-[#FF5722] shadow-[0_0_8px_#FF5722]"></span> 
      <span data-i18n="nav.grand_fleet">Grand Fleet</span>
    </a>
    <a href="#highest-bounties" class="mobile-link px-4 py-2.5 rounded-lg text-muted hover:text-[#EF4444] hover:bg-mist transition-colors flex items-center gap-3 border border-transparent hover:border-main">
      <span class="w-2 h-2 rounded-full bg-[#EF4444] shadow-[0_0_8px_#EF4444]"></span> 
      <span data-i18n="nav.top_bounties">Top Bounties</span>
    </a>

    <!-- Mobile Language Selector Section -->
    <div class="mt-2 pt-3 border-t border-main">
      <div class="text-[10px] font-mono text-muted uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>Language / भाषा चुनें</span>
        <span class="current-lang-text text-[#FF5722] font-bold">EN</span>
      </div>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="en">English</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="hi">हिंदी (Hindi)</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer text-[#FF5722] font-bold" data-lang="hinglish">Hinglish 🇮🇳</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="es">Español</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="fr">Français</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="gu">ગુજરાતી (Gujarati)</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="zh">中文 (Chinese)</button>
        <button type="button" class="lang-option px-3 py-2 rounded-lg bg-mist/60 text-xs font-mono text-left border border-main hover:border-[#FF5722] transition-colors cursor-pointer" data-lang="ja">日本語 (Japanese)</button>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme Icons update
  const themeToggleBtn = document.getElementById('theme-toggle');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');
  const lightIcon = document.getElementById('theme-toggle-light-icon');

  function updateIcons() {
    if (document.documentElement.classList.contains('dark')) {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    }
  }

  updateIcons();

  themeToggleBtn?.addEventListener('click', () => {
    if ((window as any).toggleTheme) {
      (window as any).toggleTheme();
    } else {
      document.documentElement.classList.toggle('dark');
      updateIcons();
    }
  });

  // Listen to custom theme-toggle event
  window.addEventListener('theme-toggle', () => {
    updateIcons();
  });

  // Language Switcher Dropdown Logic (Desktop & Mobile)
  const langToggleBtn = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');

  function toggleLangMenu(e?: MouseEvent) {
    e?.stopPropagation();
    const isHidden = langMenu?.classList.contains('hidden');
    if (isHidden) {
      langMenu?.classList.remove('hidden');
      langChevron?.classList.add('rotate-180');
      langToggleBtn?.setAttribute('aria-expanded', 'true');
    } else {
      langMenu?.classList.add('hidden');
      langChevron?.classList.remove('rotate-180');
      langToggleBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  langToggleBtn?.addEventListener('click', toggleLangMenu);

  // Close dropdown on clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#lang-switcher-container')) {
      langMenu?.classList.add('hidden');
      langChevron?.classList.remove('rotate-180');
      langToggleBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Language Option Click Handler
  document.querySelectorAll('.lang-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (lang && (window as any).setLanguage) {
        (window as any).setLanguage(lang, true);
      }
      langMenu?.classList.add('hidden');
      langChevron?.classList.remove('rotate-180');
    });
  });

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      const menuIconPath = document.getElementById('menu-icon-path');
      menuIconPath?.setAttribute('d', 'M6 18L18 6M6 6l12 12'); // X icon
    } else {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
      const menuIconPath = document.getElementById('menu-icon-path');
      menuIconPath?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16'); // Hamburger icon
    }
  }

  mobileMenuBtn?.addEventListener('click', toggleMenu);

  // Close menu when clicking a link
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });


  // Global Search Logic
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('search-dropdown');
  const searchResultsList = document.getElementById('search-results-list');
  const searchEmptyState = document.getElementById('search-empty-state');
  const searchOverlay = document.getElementById('search-overlay');
  
  // Inject serialized data safely
  const rawData = decodeURIComponent(atob(document.getElementById('search-data-payload')?.dataset.payload || ''));
  let searchData = [];
  try {
    searchData = JSON.parse(rawData);
  } catch(e) {}

  function openDropdown() {
    searchDropdown?.classList.remove('opacity-0', 'invisible', 'translate-y-1');
    searchDropdown?.classList.add('opacity-100', 'visible', 'translate-y-0');
    searchOverlay?.classList.remove('hidden');
  }

  function closeDropdown() {
    searchDropdown?.classList.add('opacity-0', 'invisible', 'translate-y-1');
    searchDropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
    searchOverlay?.classList.add('hidden');
  }

  function getAccentColor(color: string) {
    if (color === 'orange') return 'text-[#22D3EE] bg-[#22D3EE]/10';
    if (color === 'red') return 'text-[#EF4444] bg-[#EF4444]/10';
    if (color === 'cyan') return 'text-[#FF5722] bg-[#FF5722]/10';
    return 'text-white bg-white/10';
  }

  function renderResults(query: string) {
    if (!query) {
      if (searchResultsList) searchResultsList.innerHTML = '';
      searchEmptyState?.classList.add('hidden');
      return;
    }

    const lowerQuery = query.toLowerCase();
    const results = searchData.filter((game: any) => 
      game.title.toLowerCase().includes(lowerQuery) || 
      game.genres.some((g: string) => g.toLowerCase().includes(lowerQuery))
    ).slice(0, 5); // Max 5 results

    if (results.length === 0) {
      if (searchResultsList) searchResultsList.innerHTML = '';
      searchEmptyState?.classList.remove('hidden');
    } else {
      searchEmptyState?.classList.add('hidden');
      if (searchResultsList) {
        searchResultsList.innerHTML = results.map((game: any) => `
          <a href="/game/${game.slug}" class="flex items-center gap-3 p-2 rounded-lg hover:bg-mist transition-colors group">
            <div class="relative w-16 h-10 rounded shrink-0 overflow-hidden bg-mist border border-main">
              <img src="${game.banner}" alt="${game.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-main truncate">${game.title}</div>
              <div class="flex gap-1 mt-0.5">
                ${game.genres.slice(0,2).map((g: string) => `<span class="text-[9px] font-mono px-1 rounded ${getAccentColor(game.accentColor)}">${g}</span>`).join('')}
              </div>
            </div>
          </a>
        `).join('');
      }
    }
  }

  // Keyboard shortcut (Cmd+K / Ctrl+K)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  searchInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    renderResults(target.value.trim());
    if (target.value.trim().length > 0) {
      openDropdown();
    } else {
      closeDropdown();
    }
  });

  searchInput?.addEventListener('focus', () => {
    if (searchInput.value.trim().length > 0) {
      openDropdown();
    }
  });

  // Mobile search input sync with grid
  const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;
  mobileSearchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    const gridSearch = document.getElementById('grid-search-input') as HTMLInputElement | null;
    if (gridSearch) {
      gridSearch.value = val;
      gridSearch.dispatchEvent(new Event('input'));
    }
  });

  searchOverlay?.addEventListener('click', closeDropdown);

</script>

<div id="search-data-payload" data-payload={Buffer.from(encodeURIComponent(JSON.stringify(searchData))).toString('base64')} class="hidden"></div>
