---
// [slug].astro - Premium Game Detail & Download Page
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import GameCard from '../../components/GameCard.astro';
import { games, type Game } from '../../data/games';

export async function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;

const relatedGames = games
  .filter((g) => g.slug !== game.slug && g.genres.some((genre) => game.genres.includes(genre)))
  .slice(0, 4);

function getYouTubeEmbedUrl(url: string | undefined): string | undefined {
  if (!url) return undefined;
  
  let videoId = '';
  
  try {
    if (url.includes('youtu.be/')) {
      videoId = url.split('youtu.be/')[1]?.split('?')[0];
    } else if (url.includes('youtube.com/watch')) {
      const urlObj = new URL(url);
      videoId = urlObj.searchParams.get('v') || '';
    } else if (url.includes('/embed/')) {
      videoId = url.split('/embed/')[1]?.split('?')[0];
    }
  } catch(e) {}

  if (videoId) {
    return `https://www.youtube-nocookie.com/embed/${videoId}`;
  }
  
  return url;
}

const gameplayEmbedUrl = getYouTubeEmbedUrl(game.gameplayVideo);
---

<Layout 
  title={`${game.title} Free Download (${game.version}) — AnimeVault`}
  description={`Download ${game.title} for PC. Direct UploadHaven mirrors, zero ads, SHA-256 verified. ${game.size} • Bounty: ${game.bounty}.`}
>
  <Navbar />

  <main class="flex-1">
    
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  CINEMATIC HERO BANNER                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="relative overflow-hidden">
      <!-- Backdrop -->
      <div class="absolute inset-0">
        <img 
          src={game.banner} 
          alt="" 
          aria-hidden="true"
          class="w-full h-full object-cover object-top scale-110 blur-sm opacity-30"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F]/60 via-[#0A0A0F]/80 to-[#0A0A0F]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0F] via-transparent to-[#0A0A0F]/50"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">
        <nav class="flex items-center gap-1.5 text-[11px] font-mono text-muted mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#FF5722] transition-colors">Home</a>
          <svg class="w-3 h-3 text-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          <a href="/#bounties" class="hover:text-[#FF5722] transition-colors">Bounties</a>
          <svg class="w-3 h-3 text-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          <span class="text-main truncate max-w-[200px]">{game.title}</span>
        </nav>

        <!-- Hero Layout: Left info + Right cover -->
        <div class="flex flex-col lg:flex-row gap-8 items-start">

          <!-- Left: Game Info -->
          <div class="flex-1 min-w-0">
            <!-- Status Tags -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
              {game.isHot && (
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-wider bg-[#EF4444] text-white shadow-lg shadow-red-500/30 flex items-center gap-1">
                  <span>🔥</span> Highest Bounty
                </span>
              )}
              <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Verified Working
              </span>
              <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold bg-white/5 text-muted border border-main">
                {game.version}
              </span>
            </div>

            <!-- Title -->
            <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-mono font-extrabold text-white tracking-tight leading-tight mb-3">
              {game.title}
            </h1>

            <!-- Tagline -->
            <p class="text-base text-muted font-sans leading-relaxed max-w-2xl mb-5">
              {game.tagline}
            </p>

            <!-- Quick Stats Row -->
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono mb-6">
              <div class="flex items-center gap-1.5">
                <span class="text-amber-400">★</span>
                <span class="text-white font-bold">{game.rating}</span>
                <span class="text-muted">/ 5.0</span>
              </div>
              <div class="w-px h-3.5 bg-white/10"></div>
              <div class="flex items-center gap-1.5 text-muted">
                <svg class="w-3.5 h-3.5 text-[#FF5722]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" /></svg>
                <span class="text-white font-semibold">{game.downloads}</span> downloads
              </div>
              <div class="w-px h-3.5 bg-white/10"></div>
              <div class="flex items-center gap-1.5 text-muted">
                <svg class="w-3.5 h-3.5 text-[#22D3EE]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7c-2 0-3 1-3 3z" /></svg>
                <span class="text-white font-semibold">{game.size}</span>
              </div>
              <div class="w-px h-3.5 bg-white/10"></div>
              <div class="text-muted">
                Bounty: <span class="text-[#22D3EE] font-bold">{game.bounty}</span>
              </div>
            </div>

            <!-- Genre Pills -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {game.genres.map((g) => (
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono uppercase tracking-wider bg-white/[0.04] text-main border border-main">
                  {g}
                </span>
              ))}
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-3">
              <a 
                href="#download-portal" 
                class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl font-mono font-bold text-sm text-white bg-[#22D3EE] hover:bg-[#F4511E] shadow-xl shadow-cyan-500/25 hover:shadow-orange-400/40 hover:border-[#FF5722] border border-transparent transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#FF5722]"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                Download Now — {game.size}
              </a>
              <a 
                href="#screenshots" 
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-mono text-sm text-main bg-white/[0.05] hover:bg-white/[0.1] border border-main hover:border-hover transition-all focus:outline-none focus:ring-2 focus:ring-[#FF5722]"
              >
                <svg class="w-4 h-4 text-[#FF5722]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                View Screenshots
              </a>
            </div>
          </div>

          <!-- Right: Cover Image Card -->
          <div class="w-full lg:w-[340px] shrink-0">
            <div class="rounded-xl overflow-hidden border border-main shadow-2xl shadow-black/50 bg-mist">
              <img 
                src={game.banner} 
                alt={game.title} 
                class="w-full aspect-[3/4] object-cover"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  MAIN CONTENT AREA                                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- ─── LEFT COLUMN (8 cols) ─── -->
        <div class="lg:col-span-8 space-y-6">

          <!-- SCREENSHOTS GALLERY -->
          <section id="screenshots" class="rounded-xl bg-mist border border-main overflow-hidden scroll-mt-24">
            <div class="px-5 py-3.5 border-b border-main flex items-center justify-between">
              <h2 class="text-sm font-mono font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722]"></span>
                Screenshots & Media
              </h2>
              <span class="text-[10px] font-mono text-muted">Click to preview</span>
            </div>

            <div class="p-4">
              <!-- Main Preview -->
              <div id="main-preview-container" class="relative aspect-video rounded-lg overflow-hidden bg-black/60 border border-main mb-3 group cursor-pointer">
                <img 
                  id="main-preview-image" 
                  src={game.screenshots[0]} 
                  alt={`${game.title} Screenshot`}
                  class="w-full h-full object-cover transition-all duration-300"
                />
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/30 pointer-events-none">
                  <div class="p-3 rounded-full bg-white/10 backdrop-blur-sm pointer-events-none">
                    <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
                  </div>
                </div>

                <!-- Main Preview Prev Button -->
                <button id="main-prev-btn" class="absolute left-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white hover:bg-black/80 hover:text-[#FF5722] transition-all z-10 border border-white/10 opacity-0 group-hover:opacity-100 hidden sm:block" aria-label="Previous image">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>

                <!-- Main Preview Next Button -->
                <button id="main-next-btn" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white hover:bg-black/80 hover:text-[#FF5722] transition-all z-10 border border-white/10 opacity-0 group-hover:opacity-100 hidden sm:block" aria-label="Next image">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>

              <!-- Thumbnails -->
              <div class="grid grid-cols-4 gap-2">
                {game.screenshots.map((shot, idx) => (
                  <button 
                    type="button" 
                    class={`screenshot-thumb relative aspect-video rounded-md overflow-hidden border-2 transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FF5722] ${idx === 0 ? 'border-[#FF5722]' : 'border-main hover:border-hover'}`}
                    data-src={shot}
                  >
                    <img src={shot} alt={`Screenshot ${idx + 1}`} class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute inset-0 bg-black/0 hover:bg-black/20 transition-colors"></div>
                  </button>
                ))}
              </div>
            </div>
          </section>

          <!-- GAMEPLAY VIDEO (Optional) -->
          {gameplayEmbedUrl && (
            <section class="rounded-xl bg-mist border border-main overflow-hidden">
              <div class="px-5 py-3.5 border-b border-main">
                <h2 class="text-sm font-mono font-bold text-white flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                  Gameplay Trailer
                </h2>
              </div>
              <div class="p-4">
                <div class="relative aspect-video rounded-lg overflow-hidden bg-black border border-main">
                  <iframe 
                    class="w-full h-full"
                    src={gameplayEmbedUrl} 
                    title={`${game.title} Gameplay Video`}
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    referrerpolicy="strict-origin-when-cross-origin" 
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            </section>
          )}

          <!-- ABOUT THIS GAME -->
          <section class="rounded-xl bg-mist border border-main overflow-hidden">
            <div class="px-5 py-3.5 border-b border-main">
              <h2 class="text-sm font-mono font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE]"></span>
                About This Game
              </h2>
            </div>

            <div class="p-5">
              <p class="text-sm text-main/80 leading-relaxed font-sans mb-5">
                {game.description}
              </p>

              <div class="border-t border-main pt-4">
                <h3 class="text-xs font-mono font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
                  <span class="text-emerald-400">✦</span> Repack Features
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {game.features.map((feat) => (
                    <div class="flex items-start gap-2 p-2.5 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                      <svg class="w-3.5 h-3.5 text-emerald-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      <span class="text-xs text-main font-sans">{feat}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- SYSTEM REQUIREMENTS -->
          <section class="rounded-xl bg-mist border border-main overflow-hidden">
            <div class="px-5 py-3.5 border-b border-main">
              <h2 class="text-sm font-mono font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>
                System Requirements
              </h2>
            </div>

            <div class="p-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Minimum -->
                <div class="rounded-lg bg-void border border-main overflow-hidden">
                  <div class="px-4 py-2.5 border-b border-main bg-[#22D3EE]/5">
                    <span class="text-[10px] font-mono font-bold text-[#22D3EE] uppercase tracking-wider">Minimum</span>
                  </div>
                  <div class="p-4 space-y-3 text-xs font-mono">
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">OS</span><span class="text-white">{game.systemRequirements.os}</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Processor</span><span class="text-white">{game.systemRequirements.processor}</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Memory</span><span class="text-white">{game.systemRequirements.memory}</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Graphics</span><span class="text-white">{game.systemRequirements.graphics}</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Storage</span><span class="text-white">{game.systemRequirements.storage}</span></div>
                  </div>
                </div>

                <!-- Recommended -->
                <div class="rounded-lg bg-void border border-main overflow-hidden">
                  <div class="px-4 py-2.5 border-b border-main bg-[#FF5722]/5">
                    <span class="text-[10px] font-mono font-bold text-[#FF5722] uppercase tracking-wider">Recommended (60 FPS Ultra)</span>
                  </div>
                  <div class="p-4 space-y-3 text-xs font-mono">
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">OS</span><span class="text-white">Windows 11 (64-bit)</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Processor</span><span class="text-white">High-tier 8-core CPU</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Memory</span><span class="text-white">16 - 32 GB RAM</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Graphics</span><span class="text-white">RTX 3070 / RX 6800 XT (8 GB+)</span></div>
                    <div><span class="text-muted block text-[10px] uppercase tracking-wider mb-0.5">Storage</span><span class="text-white">NVMe SSD recommended</span></div>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </div>

        <!-- ─── RIGHT SIDEBAR (4 cols) ─── -->
        <div class="lg:col-span-4 space-y-5">

          <!-- QUICK DOWNLOAD CARD (Sticky) -->
          <div class="lg:sticky lg:top-20">

            <!-- Sidebar Download -->
            <div class="rounded-xl bg-mist border border-[#22D3EE]/30 overflow-hidden mb-5 shadow-lg shadow-cyan-500/5">
              <div class="p-5 bg-gradient-to-br from-[#22D3EE]/10 via-transparent to-transparent">
                <div class="flex items-center gap-2 mb-3">
                  <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                  <span class="text-[10px] font-mono font-bold text-emerald-400 uppercase tracking-wider">Ready to Download</span>
                </div>

                <div class="text-xl font-mono font-extrabold text-white mb-1">{game.size}</div>
                <div class="text-[11px] font-mono text-muted mb-4">Pre-installed repack • {game.version}</div>

                <a 
                  href={game.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="w-full inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-lg font-mono font-bold text-sm text-white bg-gradient-to-r from-[#22D3EE] to-[#EF4444] hover:from-[#ea580c] hover:to-[#dc2626] shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all transform hover:-translate-y-0.5"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                  Download via UploadHaven
                </a>

                <div class="flex items-center gap-2 mt-3 text-[10px] font-mono text-muted">
                  <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                  SHA-256 verified • No malware • Ad-free
                </div>
              </div>
            </div>

            <!-- GAME INFO TABLE -->
            <div class="rounded-xl bg-mist border border-main overflow-hidden mb-5">
              <div class="px-4 py-3 border-b border-main">
                <h3 class="text-xs font-mono font-bold text-white uppercase tracking-wider">Game Details</h3>
              </div>

              <div class="divide-y divide-white/[0.04]">
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">Developer</span>
                  <span class="text-[11px] font-mono text-white font-medium text-right max-w-[55%] truncate">{game.developer}</span>
                </div>
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">Publisher</span>
                  <span class="text-[11px] font-mono text-white font-medium text-right max-w-[55%] truncate">{game.publisher}</span>
                </div>
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">Release Date</span>
                  <span class="text-[11px] font-mono text-white font-medium">{game.releaseDate}</span>
                </div>
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">File Size</span>
                  <span class="text-[11px] font-mono text-[#FF5722] font-bold">{game.size}</span>
                </div>
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">Downloads</span>
                  <span class="text-[11px] font-mono text-white font-medium">{game.downloads}</span>
                </div>
                <div class="px-4 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-muted">Status</span>
                  <span class="text-[11px] font-mono text-emerald-400 font-bold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Working • No DRM
                  </span>
                </div>
              </div>

              <!-- Tags -->
              <div class="px-4 py-3 border-t border-main">
                <div class="flex flex-wrap gap-1.5">
                  {game.genres.map((g) => (
                    <span class="px-2 py-0.5 rounded text-[9px] font-mono uppercase tracking-wide bg-white/[0.04] text-muted border border-main">
                      {g}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- VERIFICATION BADGE -->
            <div class="rounded-xl bg-gradient-to-br from-emerald-500/5 to-[#14141F] border border-emerald-500/15 overflow-hidden">
              <div class="p-4 space-y-2.5">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                  <span class="text-xs font-mono font-bold text-emerald-400">Cryptographically Verified</span>
