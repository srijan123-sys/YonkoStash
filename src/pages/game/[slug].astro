---
// [slug].astro - Premium Game Detail & Download Page (English Default)
import GameDetailPage from '../../components/GameDetailPage.astro';
import { games, type Game } from '../../data/games';

export async function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<GameDetailPage game={game} lang="en" />
