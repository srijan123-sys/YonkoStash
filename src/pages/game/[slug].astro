<!-- ═══════════════════════════════════════════════════════════════════ -->
<!--  CLIENT-SIDE INTERACTIONS                                         -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
<script>
  function setupGamePage() {
    // ─── Screenshot Switcher ───
    const mainImg = document.getElementById('main-preview-image') as HTMLImageElement | null;
    const thumbs = document.querySelectorAll('.screenshot-thumb') as NodeListOf<HTMLButtonElement>;
    const allScreenshots = Array.from(thumbs).map(t => t.getAttribute('data-src') || '');
    
    const mainPrevBtn = document.getElementById('main-prev-btn');
    const mainNextBtn = document.getElementById('main-next-btn');

    function switchMainImage(index: number) {
      if (!mainImg || index < 0 || index >= allScreenshots.length) return;
      
      const targetSrc = allScreenshots[index];
      mainImg.style.opacity = '0';
      mainImg.style.transform = 'scale(1.02)';
      setTimeout(() => {
        mainImg.src = targetSrc;
        mainImg.style.opacity = '1';
        mainImg.style.transform = 'scale(1)';
      }, 200);

      // Update active thumb border
      thumbs.forEach((t, i) => {
        if (i === index) {
          t.classList.remove('border-main');
          t.classList.add('border-[#FF5722]');
        } else {
          t.classList.remove('border-[#FF5722]');
          t.classList.add('border-main');
        }
      });
    }

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        switchMainImage(index);
      });
    });

    function getCurrentMainIndex() {
      if (!mainImg) return 0;
      const activeSrc = mainImg.getAttribute('src');
      let idx = allScreenshots.findIndex(src => src === activeSrc);
      if (idx === -1) idx = allScreenshots.findIndex(src => mainImg.src.endsWith(src));
      return idx === -1 ? 0 : idx;
    }

    if (mainPrevBtn && mainNextBtn) {
      mainPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // prevent opening lightbox
        const idx = getCurrentMainIndex();
        if (idx > 0) switchMainImage(idx - 1);
      });
      mainNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = getCurrentMainIndex();
        if (idx < allScreenshots.length - 1) switchMainImage(idx + 1);
      });
    }

    // Keyboard support for main preview
    document.addEventListener('keydown', (e) => {
      const lightboxModal = document.getElementById('lightbox-modal') as HTMLDialogElement | null;
      if (lightboxModal && lightboxModal.open) return; // Lightbox handles its own keydown

      if (e.key === 'ArrowLeft') {
        const idx = getCurrentMainIndex();
        if (idx > 0) switchMainImage(idx - 1);
      } else if (e.key === 'ArrowRight') {
        const idx = getCurrentMainIndex();
        if (idx < allScreenshots.length - 1) switchMainImage(idx + 1);
      }
    });

    // ─── Lightbox Logic ───
    const lightboxModal = document.getElementById('lightbox-modal') as HTMLDialogElement | null;
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const lightboxCloseBtn = document.getElementById('lightbox-close');
    const lightboxPrevBtn = document.getElementById('lightbox-prev');
    const lightboxNextBtn = document.getElementById('lightbox-next');
    const mainPreviewContainerElem = document.getElementById('main-preview-container');

    let currentLightboxIndex = 0;

    function updateLightboxButtons() {
      if (allScreenshots.length <= 1) return;
      
      if (lightboxPrevBtn) {
        if (currentLightboxIndex > 0) {
          lightboxPrevBtn.classList.remove('hidden');
        } else {
          lightboxPrevBtn.classList.add('hidden');
        }
      }
      if (lightboxNextBtn) {
        if (currentLightboxIndex < allScreenshots.length - 1) {
          lightboxNextBtn.classList.remove('hidden');
        } else {
          lightboxNextBtn.classList.add('hidden');
        }
      }
    }

    function showLightboxImage(index: number) {
      if (index >= 0 && index < allScreenshots.length && lightboxImage) {
        currentLightboxIndex = index;
        lightboxImage.src = allScreenshots[index];
        updateLightboxButtons();
      }
    }

    if (lightboxModal && lightboxImage && mainPreviewContainerElem && mainImg) {
      // Open Lightbox
      mainPreviewContainerElem.addEventListener('click', () => {
        currentLightboxIndex = getCurrentMainIndex();
        showLightboxImage(currentLightboxIndex);
        lightboxModal.showModal();
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
      });

      // Close Lightbox (Button)
      lightboxCloseBtn?.addEventListener('click', () => {
        lightboxModal.close();
      });

      // Close Lightbox (Click Outside)
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          lightboxModal.close();
        }
      });
      
      // Handle escape key is native to <dialog>, but we need to restore scroll
      lightboxModal.addEventListener('close', () => {
        document.body.style.overflow = '';
      });

      // Prev/Next Logic
      lightboxPrevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentLightboxIndex > 0) showLightboxImage(currentLightboxIndex - 1);
      });

      lightboxNextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentLightboxIndex < allScreenshots.length - 1) showLightboxImage(currentLightboxIndex + 1);
      });

      // Keyboard navigation
      lightboxModal.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && currentLightboxIndex > 0) {
          showLightboxImage(currentLightboxIndex - 1);
        } else if (e.key === 'ArrowRight' && currentLightboxIndex < allScreenshots.length - 1) {
          showLightboxImage(currentLightboxIndex + 1);
        }
      });
    }



    // ─── Countdown Timer with Progress Bar ───
    const timerElem = document.getElementById('countdown-timer');
    const countdownWrapper = document.getElementById('countdown-wrapper');
    const countdownBar = document.getElementById('countdown-bar') as HTMLDivElement | null;
    let timeLeft = 5;

    if (timerElem && countdownWrapper && countdownBar) {
      // Start bar animation
      requestAnimationFrame(() => {
        countdownBar.style.width = '20%';
      });

      const interval = setInterval(() => {
        timeLeft--;
        const pct = ((5 - timeLeft) / 5) * 100;

        if (timeLeft > 0) {
          timerElem.textContent = `${timeLeft}s`;
          countdownBar.style.width = `${pct}%`;
        } else {
          clearInterval(interval);
          countdownBar.style.width = '100%';
          setTimeout(() => {
            countdownWrapper.innerHTML = `
              <div class="flex items-center justify-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-xs font-mono font-bold text-emerald-400">Mirror link active — click to download</span>
              </div>
            `;
          }, 300);
        }
      }, 1000);
    }

    // ─── Scroll Reveal Fade-in ───
    const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -40px 0px' };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('[data-animate]').forEach((el) => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(16px)';
      (el as HTMLElement).style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      observer.observe(el);
    });
  }

  document.addEventListener('DOMContentLoaded', setupGamePage);
</script>
