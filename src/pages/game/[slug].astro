  <!-- Fullscreen Lightbox Modal -->
  <dialog id="lightbox-modal" class="bg-transparent m-auto p-0 backdrop:bg-black/90 backdrop:backdrop-blur-sm focus:outline-none w-full max-w-7xl max-h-screen overflow-hidden">
