---
// index.astro - YonkoStash Homepage
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import GameGrid from '../components/GameGrid.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="YonkoStash — High-Performance Ad-Free Gaming Portal"
  description="Next-generation direct game library. Blazing-fast downloads, zero ad-traps, 100% verified repacks with a sleek Vercel x Anime aesthetic."
>
  <!-- Navigation -->
  <Navbar />

  <!-- Main Content -->
  <main id="main-content" class="flex-1">
    <!-- Hero Section -->
    <Hero />

    <!-- Game Catalog / The Bounties Grid -->
    <GameGrid />
  </main>

  <!-- Footer -->
  <Footer />
</Layout>
